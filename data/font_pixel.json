		"n": ["....", "....", "###.", "#..#", "#..#", "#..#", "#..#"],
		"o": ["....", "....", ".##.", "#..#", "#..#", "#..#", ".##."],
		"p": ["....", "....", "###.", "#..#", "#..#", "#..#", "###.", "#...", "#..."],
		"q": ["....", "....", ".###", "#..#", "#..#", "#..#", ".###", "...#", "...#"],
		"r": ["....", "....", "#.##", "##..", "#...", "#...", "#..."],
		"s": ["....", "....", ".###", "#...", ".##.", "...#", "###."],
